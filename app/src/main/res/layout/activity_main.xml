<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F1F3F5">
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:background="#202024">
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:text="@string/ui_1" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:contentDescription="@string/ui_2" />
        <TextView android:id="@+id/route" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="14dp" android:paddingHorizontal="14dp" android:gravity="center" android:background="@drawable/badge" android:text="@string/ui_3" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" android:contentDescription="@string/ui_4" />
        <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="end|center_vertical" android:paddingHorizontal="16dp" android:text="@string/ui_5" android:textSize="12sp" android:textColor="#FFFFFF" android:contentDescription="@string/ui_6" />
        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="16dp" android:baselineAligned="false">
        <LinearLayout android:id="@+id/stationCard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/card" android:padding="20dp" android:orientation="vertical" android:contentDescription="@string/ui_7">
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_8" />
            <TextView android:id="@+id/current" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_9" android:textColor="#202024" android:textStyle="bold" android:textSize="40sp" android:maxLines="2" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="22dp" android:background="#D9DCE1" />
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_10" android:textColor="#F44336" android:drawableEnd="@drawable/ic_bus" android:drawablePadding="5dp" />
            <TextView android:id="@+id/next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/ui_11" android:textColor="#202024" android:textStyle="bold" android:textSize="28sp" android:maxLines="2" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="16dp" android:background="@drawable/card" android:padding="20dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_12" android:textSize="14sp" android:textColor="#202024" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="@drawable/boarding">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_13" android:textColor="#1B73E8" android:textStyle="bold" android:textSize="13sp" />
                    <TextView android:id="@+id/boarding" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_14" android:textColor="#1B73E8" android:textStyle="bold" android:textSize="44sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="14dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/alighting">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_15" android:textColor="#F44336" android:textStyle="bold" android:textSize="13sp" />
                    <TextView android:id="@+id/alighting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_16" android:textColor="#F44336" android:textStyle="bold" android:textSize="44sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <kr.ac.pbl.busdriver.RouteTimeline android:id="@+id/timeline" android:layout_width="match_parent" android:layout_height="76dp" android:background="#FFFFFF" android:contentDescription="@string/ui_17" />
</LinearLayout>
